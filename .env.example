# Copy to .env and fill in. NEVER commit the real .env — bots scrape leaked keys within seconds.
#
# There is deliberately no PRIVATE_KEY here. Deployments use an encrypted Foundry keystore:
#
#   cast wallet import tawf-deployer --interactive
#   forge script ... --account tawf-deployer
#
# A plaintext key in a dotfile is one `git add -A` away from being drained.

# --- RPC ---------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Fork tests need an ARCHIVE-capable mainnet endpoint (Alchemy/Infura free tier works).
# Public endpoints reject historical state and the fork suite will skip.
MAINNET_RPC_URL=

# --- Verification ------------------------------------------------------------
ETHERSCAN_API_KEY=

# --- Deploy parameters -------------------------------------------------------
# Wallet that receives stripped yield. Defaults to the deployer if unset.
NADZIR_ADDRESS=

# WETH seeded into the mock swap desk, in wei. A full deposit-then-exit cycle pays WETH out
# twice and takes it back once, so this is the practical cap on demo volume.
# 0.05 ETH by default; anyone can refill later via router.fundWithEth().
ROUTER_WETH_SEED=50000000000000000

# --- Frontend ----------------------------------------------------------------
# Optional. Without it, only injected wallets (MetaMask etc.) are offered.
VITE_WC_PROJECT_ID=
